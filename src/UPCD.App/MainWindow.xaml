<Window x:Class="UPCD.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Universal PC Doctor" Height="780" Width="1240" MinHeight="650" MinWidth="980"
 WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
   <Setter Property="Background" Value="#182331"/>
   <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,10"/>
   <Setter Property="Margin" Value="0,4"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
   <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="GlassPanel" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="18"/>
   <Setter Property="Padding" Value="20"/>
   <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.18"/></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="22">
  <Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Style="{StaticResource GlassPanel}" Padding="16">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="4,4,4,24">
     <TextBlock Text="◈  Universal PC Doctor" FontSize="17" FontWeight="SemiBold"/>
     <TextBlock Text="BETA 0.1.0" Foreground="{DynamicResource SecondaryText}" FontSize="10" Margin="27,5,0,0"/>
    </StackPanel>
    <StackPanel>
     <ItemsControl ItemsSource="{Binding Navigation}">
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Button Content="{Binding}" HorizontalContentAlignment="Left" Click="Navigation_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Padding="12,11"/>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="4,16,4,4">
     <Button Content="✈  Telegram" Click="Telegram_Click" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="10,8"/>
     <Button Content="⌘  GitHub" Click="GitHub_Click" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="10,8"/>
     <TextBlock Text="Diagnose. Understand. Repair." Foreground="{DynamicResource SecondaryText}" FontSize="10" Margin="4,12,4,4"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <Grid Margin="0,4,0,22">
     <StackPanel>
      <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
      <TextBlock Text="{Binding WelcomeLabel}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/>
     </StackPanel>
     <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="20" Padding="12,7" Background="#2032B889" BorderBrush="#5032B889" BorderThickness="1">
      <TextBlock Text="{Binding StatusLabel}" FontSize="11" Foreground="#66D6A7"/>
     </Border>
    </Grid>
    <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,16">
     <StackPanel>
      <TextBlock Text="{Binding ScanLabel}" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding SettingsHint}" Foreground="{DynamicResource SecondaryText}" Margin="0,8,0,16" MaxWidth="700"/>
      <Button Content="{Binding ScanLabel}" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" Click="Scan_Click"/>
     </StackPanel>
    </Border>
    <UniformGrid Columns="3" Margin="0,0,0,16">
     <Border Style="{StaticResource GlassPanel}" Margin="0,0,8,0"><StackPanel><TextBlock Text="CPU" Foreground="{DynamicResource SecondaryText}"/><TextBlock Text="Not scanned" FontSize="18" Margin="0,8,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource GlassPanel}" Margin="4,0"><StackPanel><TextBlock Text="GPU" Foreground="{DynamicResource SecondaryText}"/><TextBlock Text="Not scanned" FontSize="18" Margin="0,8,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource GlassPanel}" Margin="8,0,0,0"><StackPanel><TextBlock Text="Memory" Foreground="{DynamicResource SecondaryText}"/><TextBlock Text="Not scanned" FontSize="18" Margin="0,8,0,0"/></StackPanel></Border>
    </UniformGrid>
    <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,16">
     <StackPanel>
      <TextBlock Text="{Binding SettingsLabel}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14"/>
      <TextBlock Text="{Binding LanguageLabel}" Foreground="{DynamicResource SecondaryText}"/>
      <ComboBox x:Name="LanguageBox" Margin="0,6,0,12" SelectedValuePath="Tag" SelectionChanged="Setting_Changed">
       <ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Русский" Tag="ru"/>
      </ComboBox>
      <TextBlock Text="{Binding ThemeLabel}" Foreground="{DynamicResource SecondaryText}"/>
      <ComboBox x:Name="ThemeBox" Margin="0,6,0,12" SelectedValuePath="Tag" SelectionChanged="Setting_Changed">
       <ComboBoxItem Content="System / Как в системе" Tag="system"/><ComboBoxItem Content="Dark / Тёмная" Tag="dark"/><ComboBoxItem Content="Light / Светлая" Tag="light"/>
      </ComboBox>
      <TextBlock Text="{Binding ModeLabel}" Foreground="{DynamicResource SecondaryText}"/>
      <ComboBox x:Name="ModeBox" Margin="0,6,0,12" SelectedValuePath="Tag" SelectionChanged="Setting_Changed">
       <ComboBoxItem Content="Simple / Обычный" Tag="simple"/><ComboBoxItem Content="Advanced / Расширенный" Tag="advanced"/>
      </ComboBox>
      <TextBlock Text="{Binding AccentLabel}" Foreground="{DynamicResource SecondaryText}"/>
      <ItemsControl ItemsSource="{Binding AccentOptions}" Margin="0,8,0,12">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate><Button Width="30" Height="30" Padding="0" Margin="0,0,9,8" Background="{Binding}" BorderBrush="#80FFFFFF" Click="Accent_Click" Tag="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding UpdatesLabel}" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,8"/>
      <CheckBox Content="{Binding AutoCheckLabel}" IsChecked="{Binding AutoCheckUpdates}" Foreground="{DynamicResource PrimaryText}" Margin="0,4"/>
      <CheckBox Content="{Binding WifiDownloadLabel}" IsChecked="{Binding DownloadUpdatesOnWifi}" Foreground="{DynamicResource PrimaryText}" Margin="0,4"/>
      <CheckBox Content="{Binding NotifyUpdatesLabel}" IsChecked="{Binding NotifyAboutUpdates}" Foreground="{DynamicResource PrimaryText}" Margin="0,4"/>
      <CheckBox Content="{Binding ConfirmInstallLabel}" IsChecked="{Binding InstallAfterConfirmation}" Foreground="{DynamicResource PrimaryText}" Margin="0,4"/>
      <TextBlock Text="{Binding UpdateStatus}" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,8,0,12"/>
      <Button Content="{Binding SaveLabel}" HorizontalAlignment="Left" Click="Save_Click" Background="{DynamicResource AccentBrush}"/>
      <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryText}" Margin="0,10,0,0"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
